# Local development works with these optional settings left empty.
PORT=3001
# Production: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Production bootstrap only: choose 6-12 digits. Local demo defaults to 2026.
ORGANIZER_PIN=
# Required together in production, after running migration 002_persistent_state.sql.
# Server-only credentials. Never prefix the service-role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional canonical public origin, e.g. https://cards.example.com
PRODUCTION_DOMAIN=
# Optional comma-separated additional frontend origins. Same-origin is allowed.
ALLOWED_ORIGINS=
# Default 0 locally, 1 on Vercel. Match your trusted reverse proxy configuration.
TRUST_PROXY_HOPS=
# Optional local-only file path. Default server/data/local-db.json (gitignored).
DB_FILE=
