# UCHIHA CONNECT STUDIO (UC) — ENVIRONMENT CONFIGURATION
# Tagline: One Identity. Every Connection.

# Port for local backend API server (defaults to 3001)
PORT=3001

# Secret key for signing organizer session tokens
SESSION_SECRET=uc_organizer_secure_session_secret_key_2026

# Optional: Supabase PostgreSQL & Storage configuration
# If not provided, UCHIHA CONNECT runs with zero-config local persistence in server/data/db.json
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Domain for high-res print QR codes & card links
PRODUCTION_DOMAIN=https://uchihaconnect.com
